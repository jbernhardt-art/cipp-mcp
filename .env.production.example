# Private address on the Ubuntu server. Docker publishes HTTPS only here.
MCP_HTTPS_BIND_IP=192.0.2.10

# CIPP API client credentials. Use the Function App URL, not the CIPP UI URL.
CIPP_BASE_URL=https://cipp-example.azurewebsites.net
CIPP_TENANT_ID=00000000-0000-0000-0000-000000000000
CIPP_CLIENT_ID=00000000-0000-0000-0000-000000000000
CIPP_CLIENT_SECRET=replace-me

# Exact server-side allowlist. Add reviewed tool names only.
CIPP_ENABLED_TOOLS=cipp_ping,cipp_get_version,cipp_list_tenants

# One SHA-256 hash per engineer. Never put raw bearer tokens here.
MCP_HTTP_CLIENT_AUTH=bearer
MCP_HTTP_BEARER_TOKEN_HASHES=engineer1=replace-with-64-character-sha256
MCP_HTTP_TRUST_PROXY=true

AUTH_MODE=env
LOG_LEVEL=info
LOG_FORMAT=json
